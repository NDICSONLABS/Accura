msgid "Journal entry saved as DRAFT."
msgstr "Écriture enregistrée en brouillon."

msgid "At least one journal line is required."
msgstr "Au moins une ligne d'écriture est requise."

msgid "Every non-zero journal line requires an account code."
msgstr "Toute ligne non nulle doit avoir un code compte."

msgid "Negative amounts are not allowed. Use debit/credit correctly."
msgstr ""
"Les montants négatifs ne sont pas autorisés. Utilisez correctement le "
"débit/crédit."

msgid "A journal line cannot have both debit and credit."
msgstr "Une ligne d'écriture ne peut pas avoir à la fois un débit et un crédit."

msgid "A journal line cannot carry both a debit and a credit."
