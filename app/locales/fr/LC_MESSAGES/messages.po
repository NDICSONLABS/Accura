msgid "Cannot create entry: Accounting period is not OPEN."
msgstr "Impossible de créer l'écriture : la période comptable n'est pas OUVERTE."

msgid "Cannot create entry: Fiscal year is not OPEN."
msgstr "Impossible de créer l'écriture : l'exercice n'est pas OUVERT."

msgid "Selected period does not belong to the selected fiscal year."
msgstr "La période sélectionnée n'appartient pas à l'exercice sélectionné."

msgid "Entry date falls outside the selected accounting period."
msgstr "La date de l'écriture est en dehors de la période comptable sélectionnée."

msgid "Only POSTED entries can be reversed."
msgstr "Seules les écritures VALIDÉES peuvent être contre-passées."

msgid "No OPEN accounting period is available for the reversal date."
msgstr ""
"Aucune période comptable OUVERTE n'est disponible pour la date de contre-"
"passation."

msgid "Maker-Checker rule violated: Approver cannot be the same as the creator."
msgstr "Règle Maker-Checker violée : l'approbateur ne peut pas être le créateur."

msgid "Cannot post entry: Accounting period is not OPEN."
msgstr "Impossible de valider l'écriture : la période comptable n'est pas OUVERTE."

msgid "Period is already permanently closed."
msgstr "La période est déjà définitivement clôturée."

msgid "Period not found"
msgstr "Période introuvable"

msgid "Entry not found."
msgstr "Écriture introuvable."

msgid "Entry cannot be zero."
msgstr "L'écriture ne peut pas être nulle."

msgid "Cannot reverse: target fiscal year is not OPEN."
msgstr "Impossible de contre-passer : l'exercice cible n'est pas OUVERT."

msgid "Original journal not found."
msgstr "Journal d'origine introuvable."

msgid "Bill must be in DRAFT status to post."
msgstr "La facture doit être en statut BROUILLON pour être validée."

msgid "Withholding tax is not enabled in organization settings."
msgstr ""
"La retenue à la source n'est pas activée dans les paramètres de "
"l'organisation."

msgid "Withholding tax cannot exceed total bill amount."
msgstr ""
"La retenue à la source ne peut pas dépasser le montant total de la "
"facture."

